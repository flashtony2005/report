# 依赖
node_modules/

# 构建产物
dist/
dist-sdk/
dist-sdk.zip
dist-ssr/
coverage/
.verify-dist/
*.tsbuildinfo

# 本地验证转储（CDP 截图 / 测试输出 dump）
designer-react/.shots/

# Rust 构建产物
print-server/target/
print-server/tgt/

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 本地环境
*.local
.env
.env.*

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 项目记忆（不入公开仓库）
.workbuddy/

# 报表定义文件（用户数据：含本地库路径，可能含连接信息；origin 是公开仓库）
print-server/reports/

# 本机覆盖配置（每台机器路径不同，例如 F:\... 这种，不该进公开仓库）
*.local.json

# 打印 spool（每次 /print 落盘的 PDF / HTML / 票据指令，是产物不是源码；
# 里面还带本机路径与任务号，跟 reports/ 同理不该进公开仓库）
print-server/spool/

# ODBC 真机探针的临时目录（探针自建自用：odbcinst.ini / odbc.ini / probe.db /
# 一份临时 print-server.json。里面写死了本机 driver 绝对路径，是产物不是源码）
.odbc-probe/

# 故障注入脚本的源文件备份（脚本用内存字符串还原，不该落盘；
# 早期版本留过 .inject-backup，这里兜一层，避免误提交一份「被注入过」的源码）
*.inject-backup

# 会话期自动落下的整页截图（SHA-1 命名的 PNG，3MB 级，出现在仓库根目录）。
# 是产物不是源码，且会反复生成 —— 不加规则的话 git status 一直被它污染。
# 只匹配「根目录 + 一长串十六进制 + .png」，别动根目录那几张人工留的验证截图
# （网格报表-*.png 是被跟踪的，故意保留）。
/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.png

# 同上的另一种命名：UUID 形式（8-4-4-4-12，带连字符）。
# 上面那条要求「前 16 位都是十六进制」，连字符一出现就断掉，所以这类截图**漏网**。
# 实测根目录没有已跟踪的 .png，且没有已跟踪文件命中本规则（规则不会误伤）。
/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].png

# Python 字节码（`python3 -m py_compile` / import 会生成）。
# scripts/ 下的脚本会被反复编译，不忽略的话 git status 一直挂着一个目录。
__pycache__/
*.pyc
