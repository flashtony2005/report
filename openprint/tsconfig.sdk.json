{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/sdk/**/*", "src/core/**/*", "src/types/**/*", "src/utils/**/*", "src/config/**/*"],
  "exclude": ["src/**/__tests__/*", "src/**/*.spec.ts"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sdk.tsbuildinfo",

    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // 让产物路径为 dist-sdk/types/sdk/index.d.ts（而非 dist-sdk/types/src/sdk/...）
    "rootDir": "./src",
    "declarationDir": "./dist-sdk/types"
  }
}
