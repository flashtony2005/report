{
  "version": "1.0",
  "document": {
    "type": "report",
    "page": {
      "width": 210,
      "height": 297,
      "unit": "mm",
      "orientation": "portrait",
      "margin": {
        "top": 12,
        "right": 12,
        "bottom": 10,
        "left": 12
      }
    },
    "sections": [
      {
        "type": "header",
        "height": 24,
        "repeat": true,
        "components": [
          {
            "id": "hd-company",
            "type": "text",
            "left": 12,
            "top": 0,
            "width": 100,
            "height": 6,
            "value": "深圳某某科技有限公司",
            "style": {
              "fontSize": 10,
              "fontWeight": "bold",
              "fill": "#333333"
            },
            "printable": true
          },
          {
            "id": "hd-title",
            "type": "text",
            "left": 12,
            "top": 7,
            "width": 186,
            "height": 11,
            "value": "销售出库单",
            "style": {
              "fontSize": 18,
              "fontWeight": "bold",
              "textAlign": "center"
            },
            "printable": true
          },
          {
            "id": "hd-barcode",
            "type": "barcode",
            "left": 152,
            "top": 0,
            "width": 46,
            "height": 12,
            "binding": "order.orderNo",
            "format": "code128",
            "showText": false,
            "printable": true
          },
          {
            "id": "hd-rule",
            "type": "line",
            "left": 12,
            "top": 21,
            "width": 186,
            "height": 0,
            "stroke": "#333333",
            "strokeWidth": 1,
            "printable": true
          }
        ]
      },
      {
        "type": "body",
        "components": [
          {
            "id": "bd-no",
            "type": "text",
            "left": 12,
            "top": 12,
            "width": 62,
            "height": 6,
            "value": "单号：{{order.orderNo}}",
            "printable": true,
            "style": {
              "fontSize": 10,
              "fontFamily": "思源黑体"
            }
          },
          {
            "id": "bd-date",
            "type": "text",
            "left": 74,
            "top": 12,
            "width": 62,
            "height": 6,
            "value": "日期：{{order.orderDate}}",
            "printable": true,
            "style": {
              "fontSize": 10,
              "fontFamily": "思源黑体"
            }
          },
          {
            "id": "bd-salesman",
            "type": "text",
            "left": 136,
            "top": 12,
            "width": 62,
            "height": 6,
            "value": "业务员：{{order.salesman}}",
            "printable": true,
            "style": {
              "fontSize": 10,
              "fontFamily": "思源黑体"
            }
          },
          {
            "id": "bd-cust",
            "type": "text",
            "left": 12,
            "top": 19,
            "width": 92,
            "height": 6,
            "value": "客户：{{customer.name}}",
            "printable": true,
            "style": {
              "fontSize": 10,
              "fontFamily": "思源黑体"
            }
          },
          {
            "id": "bd-contact",
            "type": "text",
            "left": 104,
            "top": 19,
            "width": 94,
            "height": 6,
            "value": "联系人：{{customer.contact}}　电话：{{customer.phone}}",
            "printable": true,
            "style": {
              "fontSize": 10,
              "fontFamily": "思源黑体"
            }
          },
          {
            "id": "bd-addr",
            "type": "text",
            "left": 12,
            "top": 26,
            "width": 186,
            "height": 6,
            "value": "收货地址：{{customer.address}}",
            "printable": true,
            "style": {
              "fontSize": 10,
              "fontFamily": "思源黑体"
            }
          },
          {
            "id": "bd-table",
            "type": "table",
            "left": 12,
            "top": 35,
            "width": 186,
            "height": 60,
            "dataSource": "items",
            "printable": true,
            "data": [
              {
                "productCode": "PD-1001",
                "productName": "无线鼠标",
                "spec": "2.4G",
                "unit": "个",
                "qty": 2,
                "price": 45,
                "amount": 90
              },
              {
                "productCode": "PD-1002",
                "productName": "机械键盘",
                "spec": "87键",
                "unit": "个",
                "qty": 1,
                "price": 320,
                "amount": 320
              },
              {
                "productCode": "PD-1003",
                "productName": "USB集线器",
                "spec": "4口",
                "unit": "个",
                "qty": 3,
                "price": 65,
                "amount": 195
              },
              {
                "productCode": "PD-1004",
                "productName": "六类网线",
                "spec": "1.5m",
                "unit": "根",
                "qty": 5,
                "price": 12,
                "amount": 60
              },
              {
                "productCode": "PD-1005",
                "productName": "高清摄像头",
                "spec": "1080P",
                "unit": "个",
                "qty": 1,
                "price": 180,
                "amount": 180
              }
            ],
            "columns": [
              {
                "title": "序号",
                "expression": "{{rowIndex + 1}}",
                "width": 14,
                "align": "center",
                "headerAlign": "center"
              },
              {
                "title": "商品编码",
                "field": "productCode",
                "width": 26,
                "align": "left",
                "headerAlign": "center"
              },
              {
                "title": "商品名称",
                "field": "productName",
                "width": 58,
                "align": "left",
                "headerAlign": "center"
              },
              {
                "title": "规格型号",
                "field": "spec",
                "width": 34,
                "align": "left",
                "headerAlign": "center"
              },
              {
                "title": "单位",
                "field": "unit",
                "width": 12,
                "align": "center",
                "headerAlign": "center"
              },
              {
                "title": "数量",
                "field": "qty",
                "width": 12,
                "align": "right",
                "headerAlign": "center"
              },
              {
                "title": "单价",
                "field": "price",
                "width": 14,
                "align": "right",
                "headerAlign": "center"
              },
              {
                "title": "金额",
                "field": "amount",
                "width": 16,
                "align": "right",
                "headerAlign": "center"
              }
            ],
            "options": {
              "repeatHeader": true,
              "repeatFooter": false,
              "pageRows": "auto",
              "rowHeightMode": "auto",
              "borders": "all",
              "striped": true,
              "verticalAlign": "middle",
              "summaryRow": {
                "type": "sum",
                "fields": [
                  "qty",
                  "amount"
                ],
                "label": "合计"
              }
            }
          },
          {
            "id": "bd-total",
            "type": "text",
            "left": 12,
            "top": 97,
            "width": 186,
            "height": 7,
            "value": "合计金额（大写）：{{order.total | currency:\"CNY\"}}",
            "printable": true,
            "style": {
              "fontSize": 11,
              "fontFamily": "思源黑体",
              "fontWeight": "bold"
            }
          },
          {
            "id": "bd-memo",
            "type": "text",
            "left": 12,
            "top": 105,
            "width": 120,
            "height": 6,
            "value": "备注：{{order.memo}}",
            "printable": true,
            "style": {
              "fontSize": 9,
              "fontFamily": "思源黑体",
              "fill": "#555555"
            }
          },
          {
            "id": "bd-sign",
            "type": "text",
            "left": 12,
            "top": 115,
            "width": 186,
            "height": 6,
            "value": "制单人：{{order.salesman}}　　审核：＿＿＿＿　　仓管：＿＿＿＿　　客户签收：＿＿＿＿",
            "printable": true,
            "style": {
              "fontSize": 9,
              "fontFamily": "思源黑体"
            }
          }
        ]
      },
      {
        "type": "footer",
        "height": 12,
        "repeat": true,
        "components": [
          {
            "id": "ft-rule",
            "type": "line",
            "left": 12,
            "top": 1,
            "width": 186,
            "height": 0,
            "stroke": "#999999",
            "strokeWidth": 0.5,
            "printable": true
          },
          {
            "id": "ft-brand",
            "type": "text",
            "left": 12,
            "top": 3,
            "width": 90,
            "height": 6,
            "value": "本单据由 OpenPrint 生成",
            "printable": true,
            "style": {
              "fontSize": 8,
              "fontFamily": "思源黑体",
              "fill": "#888888"
            }
          },
          {
            "id": "ft-page",
            "type": "text",
            "left": 108,
            "top": 3,
            "width": 90,
            "height": 6,
            "value": "第 {{page}} 页 / 共 {{pages}} 页",
            "printable": true,
            "style": {
              "fontSize": 9,
              "fontFamily": "思源黑体",
              "textAlign": "right",
              "fill": "#555555"
            }
          }
        ]
      }
    ]
  }
}