{
  "name": "openprint-designer-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenPrint 设计器 React 版（引擎复用 openprint/src 的框架无关层，UI 层重写）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5190",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:app": "vitest run --exclude \"../openprint/src/**\"",
    "test:engine": "vitest run -c vitest.engine.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-font-family": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@univerjs/core": "^0.25.1",
    "@univerjs/docs": "^0.25.1",
    "@univerjs/docs-ui": "^0.25.1",
    "@univerjs/engine-render": "^0.25.1",
    "@univerjs/network": "^0.25.1",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "@univerjs/sheets": "^0.25.1",
    "@univerjs/sheets-ui": "^0.25.1",
    "@univerjs/ui": "^0.25.1",
    "antd": "^6.6.3",
    "codemirror": "^6.0.2",
    "fabric": "^7.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unocss": "^66.7.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "happy-dom": "^20.11.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
